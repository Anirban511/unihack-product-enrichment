# Copy to .env and fill in. .env is gitignored - never commit a real key.
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Browser tier. Leave the paths blank locally (Selenium finds Chrome itself);
# the Docker image sets them to the Chromium it ships.
ENABLE_SELENIUM=true
# CHROME_BINARY=/usr/bin/chromium
# CHROMEDRIVER_PATH=/usr/bin/chromedriver

# Where the Streamlit front end should look for the API.
API_BASE_URL=http://127.0.0.1:8000
